* text=auto eol=lf

# Explicitly mark text files to use LF
*.md text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
